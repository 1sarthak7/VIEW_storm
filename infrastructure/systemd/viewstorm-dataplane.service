[Unit]
Description=ViewStorm Dedicated Data Plane (Playback Event Ingestion API)
After=network.target redis.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=viewstorm
Group=viewstorm
WorkingDirectory=/opt/viewstorm/backend
Environment="PATH=/opt/viewstorm/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/etc/default/viewstorm-dataplane
Environment="VIEWSTORM_SERVICE_MODE=data_plane"
ExecStart=/opt/viewstorm/.venv/bin/uvicorn app.dataplane_main:app \
    --host 0.0.0.0 \
    --port 8001 \
    --workers 8 \
    --log-level info

Restart=always
RestartSec=5s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=viewstorm-dataplane

[Install]
WantedBy=multi-user.target
